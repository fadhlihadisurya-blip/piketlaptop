rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny seluruh jalur tak dikenal
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIF & HELPER KEAMANAN GLOBAL
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() in [
        'fadhlihadisurya@gmail.com',
        'f4dly.ank2@gmail.com'
      ];
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email.lower() in ['fadhlihadisurya@gmail.com', 'f4dly.ank2@gmail.com']
        || request.auth.token.firebase.sign_in_provider == 'password'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['piket', 'admin']
      );
    }

    function isLocalStaff(actorUid) {
      return isValidId(actorUid)
        && exists(/databases/$(database)/documents/staff_roles/$(actorUid))
        && get(/databases/$(database)/documents/staff_roles/$(actorUid)).data.role in ['admin', 'piket'];
    }

    function isLocalAdmin(actorUid) {
      return isValidId(actorUid)
        && exists(/databases/$(database)/documents/staff_roles/$(actorUid))
        && get(/databases/$(database)/documents/staff_roles/$(actorUid)).data.role == 'admin';
    }

    function hasAdminStaffRole() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/staff_roles/$('role-' + hashing.sha256(request.auth.token.email.lower()).toHexString().lower()))
        && get(/databases/$(database)/documents/staff_roles/$('role-' + hashing.sha256(request.auth.token.email.lower()).toHexString().lower())).data.email.lower() == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/staff_roles/$('role-' + hashing.sha256(request.auth.token.email.lower()).toHexString().lower())).data.role == 'admin';
    }

    // =========================================================================
    // VALIDASI SKEMA ENTITAS (BLUEPRINT SYNCHRONICITY)
    // =========================================================================
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.role is string && data.role in ['admin', 'piket']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data, userId) {
      return data.keys().hasAll(['uid', 'grantedByUid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedByUid', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.grantedByUid is string && isValidId(data.grantedByUid)
        && data.createdAt is timestamp;
    }

    function isValidStaffRole(data) {
      return data.keys().hasAll(['email', 'fullName', 'role', 'assignedByUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['username', 'email', 'fullName', 'role', 'password', 'assignedByUid', 'createdAt', 'updatedAt'])
        && (!data.keys().hasAll(['username']) || (data.username is string && data.username.size() >= 1 && data.username.size() <= 80))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.role is string && data.role in ['admin', 'piket']
        && (!data.keys().hasAll(['password']) || (data.password is string && data.password.size() <= 100))
        && data.assignedByUid is string && isValidId(data.assignedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchoolClass(data) {
      return data.keys().hasAll(['name', 'schoolCode', 'createdByUid', 'createdAt'])
        && data.keys().hasOnly(['name', 'schoolCode', 'createdByUid', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.schoolCode is string && data.schoolCode == 'ASSYIFA-WRJ'
        && data.createdByUid is string && isValidId(data.createdByUid)
        && data.createdAt is timestamp;
    }

    function isValidStudentLaptop(data) {
      return data.keys().hasAll([
          'nis', 'nama', 'kelas', 'foto', 'laptopCode', 'laptopBrand',
          'laptopStatus', 'blocked', 'blockReason', 'lastActivityAt',
          'lastHandledBy', 'schoolCode', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'nis', 'nama', 'kelas', 'foto', 'laptopCode', 'laptopBrand',
          'laptopStatus', 'blocked', 'blockReason', 'lastActivityAt',
          'lastHandledBy', 'schoolCode', 'updatedByUid', 'createdAt', 'updatedAt'
        ])
        && data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 40 && data.nis.matches('^[a-zA-Z0-9_\\-]+$')
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.kelas is string && data.kelas.size() >= 1 && data.kelas.size() <= 60
        && data.foto is string && data.foto.size() <= 100000
        && data.laptopCode is string && data.laptopCode.size() >= 1 && data.laptopCode.size() <= 40 && data.laptopCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.laptopBrand is string && data.laptopBrand.size() >= 1 && data.laptopBrand.size() <= 100
        && data.laptopStatus is string && data.laptopStatus in ['tersedia', 'dibawa']
        && data.blocked is bool
        && data.blockReason is string && data.blockReason.size() <= 500
        && data.lastActivityAt is string && data.lastActivityAt.size() <= 40
        && data.lastHandledBy is string && data.lastHandledBy.size() <= 120
        && data.schoolCode is string && data.schoolCode == 'ASSYIFA-WRJ'
        && data.updatedByUid is string && isValidId(data.updatedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCirculationLog(data) {
      return data.keys().hasAll([
          'id', 'dateKey', 'nis', 'nama', 'kelas', 'laptopCode',
          'waktuAmbil', 'waktuKembali', 'petugasAmbil', 'petugasKembali',
          'status', 'schoolCode', 'handledByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'dateKey', 'nis', 'nama', 'kelas', 'laptopCode',
          'waktuAmbil', 'waktuKembali', 'petugasAmbil', 'petugasKembali',
          'status', 'schoolCode', 'handledByUid', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 80 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 20
        && data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 40 && data.nis.matches('^[a-zA-Z0-9_\\-]+$')
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.kelas is string && data.kelas.size() >= 1 && data.kelas.size() <= 60
        && data.laptopCode is string && data.laptopCode.size() >= 1 && data.laptopCode.size() <= 40 && data.laptopCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.waktuAmbil is string && data.waktuAmbil.size() <= 40
        && data.waktuKembali is string && data.waktuKembali.size() <= 40
        && data.petugasAmbil is string && data.petugasAmbil.size() <= 120
        && data.petugasKembali is string && data.petugasKembali.size() <= 120
        && data.status is string && data.status in ['Dibawa Murid', 'Selesai Kembali']
        && data.schoolCode is string && data.schoolCode == 'ASSYIFA-WRJ'
        && data.handledByUid is string && isValidId(data.handledByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // KOLEKSI 1: /users/{userId} (PII-Free User Profile & Role)
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == userId));
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isBootstrapAdmin());

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (request.auth.uid == userId && incoming().role == 'piket')
          || (request.auth.uid == userId && incoming().role == 'admin' && (hasAdminStaffRole() || request.auth.token.firebase.sign_in_provider == 'password'))
        );

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            request.auth.uid == userId
            && incoming().role == 'admin'
            && hasAdminStaffRole()
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'updatedAt'])
          )
          || (
            request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // =========================================================================
    // KOLEKSI 2: /admins/{userId} (Penanda Hak Administrator)
    // =========================================================================
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == userId));
      allow list: if isBootstrapAdmin();

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && userId == request.auth.uid
        && isValidAdminMarker(incoming(), userId)
        && incoming().grantedByUid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    // =========================================================================
    // KOLEKSI 3: /staff_roles/{roleId} (Akun Staf & Admin Lokal Firestore)
    // =========================================================================
    match /staff_roles/{roleId} {
      allow get: if isValidId(roleId);
      allow list: if resource.data.role in ['admin', 'piket'];

      allow create: if isValidId(roleId)
        && isValidStaffRole(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().assignedByUid == request.auth.uid)
          || isLocalAdmin(incoming().assignedByUid)
        );

      allow update: if isValidId(roleId)
        && isValidStaffRole(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().email.lower() != 'fadhlihadisurya@gmail.com'
        && existing().email.lower() != 'f4dly.ank2@gmail.com'
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'email', 'fullName', 'role', 'password', 'assignedByUid', 'updatedAt'])
        && (
          (isAdmin() && incoming().assignedByUid == request.auth.uid)
          || isLocalAdmin(incoming().assignedByUid)
        );

      allow delete: if isValidId(roleId)
        && existing().email.lower() != 'fadhlihadisurya@gmail.com'
        && existing().email.lower() != 'f4dly.ank2@gmail.com'
        && (isAdmin() || resource.data.role in ['admin', 'piket']);
    }

    // =========================================================================
    // KOLEKSI 4: /classes/{classId} (Dropdown Kelas - Khusus Admin)
    // =========================================================================
    match /classes/{classId} {
      allow get: if isValidId(classId) && resource.data.schoolCode == 'ASSYIFA-WRJ';
      allow list: if resource.data.schoolCode == 'ASSYIFA-WRJ';

      allow create: if isValidId(classId)
        && isValidSchoolClass(incoming())
        && incoming().createdAt == request.time
        && (
          (isAdmin() && incoming().createdByUid == request.auth.uid)
          || isLocalAdmin(incoming().createdByUid)
        );

      allow update: if false;
      allow delete: if isValidId(classId) && (isAdmin() || resource.data.schoolCode == 'ASSYIFA-WRJ');
    }

    // =========================================================================
    // KOLEKSI 5: /students/{studentId} (Database 1-on-1 Murid & Laptop)
    // =========================================================================
    match /students/{studentId} {
      allow get: if isValidId(studentId) && resource.data.schoolCode == 'ASSYIFA-WRJ';
      allow list: if resource.data.schoolCode == 'ASSYIFA-WRJ';

      allow create: if isValidId(studentId)
        && isValidStudentLaptop(incoming())
        && incoming().nis == studentId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().updatedByUid == request.auth.uid)
          || isLocalAdmin(incoming().updatedByUid)
        );

      allow update: if isValidId(studentId)
        && isValidStudentLaptop(incoming())
        && incoming().nis == existing().nis
        && incoming().schoolCode == existing().schoolCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().updatedByUid == request.auth.uid)
          || isLocalAdmin(incoming().updatedByUid)
          || (
            existing().blocked == false
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'laptopStatus', 'lastActivityAt', 'lastHandledBy', 'updatedByUid', 'updatedAt'
            ])
            && (
              (isStaff() && incoming().updatedByUid == request.auth.uid)
              || isLocalStaff(incoming().updatedByUid)
            )
          )
        );

      allow delete: if isValidId(studentId) && (isAdmin() || resource.data.schoolCode == 'ASSYIFA-WRJ');
    }

    // =========================================================================
    // KOLEKSI 6: /circulation_logs/{logId} (Riwayat Pengambilan & Pengembalian)
    // =========================================================================
    match /circulation_logs/{logId} {
      allow get: if isValidId(logId) && resource.data.schoolCode == 'ASSYIFA-WRJ';
      allow list: if resource.data.schoolCode == 'ASSYIFA-WRJ';

      allow create: if isValidId(logId)
        && isValidCirculationLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().nis))
        && get(/databases/$(database)/documents/students/$(incoming().nis)).data.blocked == false
        && (
          (isStaff() && incoming().handledByUid == request.auth.uid)
          || isLocalStaff(incoming().handledByUid)
        );

      allow update: if isValidId(logId)
        && isValidCirculationLog(incoming())
        && incoming().id == existing().id
        && incoming().nis == existing().nis
        && incoming().schoolCode == existing().schoolCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().handledByUid == request.auth.uid)
          || isLocalAdmin(incoming().handledByUid)
          || (
            existing().status == 'Dibawa Murid'
            && incoming().status == 'Selesai Kembali'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'waktuKembali', 'petugasKembali', 'status', 'handledByUid', 'updatedAt'
            ])
            && (
              (isStaff() && incoming().handledByUid == request.auth.uid)
              || isLocalStaff(incoming().handledByUid)
            )
          )
        );

      allow delete: if isValidId(logId) && (isAdmin() || resource.data.schoolCode == 'ASSYIFA-WRJ');
    }
  }
}
